# Copy to .env.local for local development and fill in the values.
# Never commit real values: this repository is public.
# Production values live in Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses row-level security, so keep it secret.
SUPABASE_SERVICE_ROLE_KEY=

# Twilio → Console. Used to send WhatsApp messages, including booking codes.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The WhatsApp sender number, e.g. +14155238886 (without the "whatsapp:" prefix)
TWILIO_WHATSAPP_FROM=

# Where invited staff are sent after accepting an invite
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: email alerts for new shop orders, sent through Resend (resend.com).
# Without these, order emails are skipped.
RESEND_API_KEY=
RESEND_FROM=Custozo <orders@yourdomain.com>

# Optional: "Fill details from photo with AI" on items (Anthropic API, billed per use).
ANTHROPIC_API_KEY=
